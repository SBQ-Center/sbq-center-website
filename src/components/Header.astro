---
export interface NavLink {
  href: string;
  label: string;
  active?: boolean;
}

export interface Props {
  lang?: string;
  links: NavLink[];
  langHref: string;
}

const { lang = 'ar', links, langHref } = Astro.props;
const isAr = lang === 'ar';
const centerName = isAr ? 'مركز سبق' : 'Sabq Center';
const centerTagline = isAr ? 'الدراسات والاستشارات' : 'Studies & Consulting';
const langLabel = isAr ? 'English' : 'العربية';
const menuLabel = isAr ? 'فتح القائمة' : 'Open menu';
---
<header class="site-header" data-component="site-header">
  <div class="site-header__inner">
    <a href={isAr ? '/' : '/en/'} class="logo" aria-label={centerName}>
      <img src="/logo.svg" alt={centerName} class="logo__brand-image" />
      <span class="logo__text">
        <span class="logo__name">{centerName}</span>
        <span class="logo__tagline">{centerTagline}</span>
      </span>
    </a>

    <nav class="nav-desktop" aria-label={isAr ? 'القائمة الرئيسية' : 'Main navigation'}>
      <ul class="nav-desktop__list">
        {links.map(link => (
          <li>
            <a href={link.href} class={`nav-desktop__link${link.active ? ' active' : ''}`}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <a href={langHref} class="lang-switch">{langLabel}</a>
      <button class="menu-toggle" type="button" aria-label={menuLabel} aria-expanded="false" aria-controls="nav-mobile">
        <span class="menu-toggle__icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>
</header>

<nav class="nav-mobile" id="nav-mobile" aria-label={isAr ? 'قائمة الهاتف' : 'Mobile navigation'}>
  <ul class="nav-mobile__list">
    {links.map(link => (
      <li>
        <a href={link.href} class={`nav-mobile__link${link.active ? ' active' : ''}`}>
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<div class="nav-overlay" id="nav-overlay" aria-hidden="true"></div>

<script>
(() => {
  const root = document.querySelector('[data-component="site-header"]');
  if (!root) return;

  const toggle = root.querySelector('.menu-toggle');
  const panel = document.getElementById('nav-mobile');
  const overlay = document.getElementById('nav-overlay');
  if (!toggle || !panel || !overlay) return;

  const docLang = document.documentElement.lang || 'ar';
  const isArLocal = docLang === 'ar';
  const openLabel = isArLocal ? 'فتح القائمة' : 'Open menu';
  const closeLabel = isArLocal ? 'إغلاق القائمة' : 'Close menu';

  function openMenu() {
    toggle.setAttribute('aria-expanded', 'true');
    toggle.setAttribute('aria-label', closeLabel);
    panel.classList.add('is-open');
    overlay.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', openLabel);
    panel.classList.remove('is-open');
    overlay.classList.remove('is-open');
    document.body.style.overflow = '';
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', attach);
  } else {
    attach();
  }

  function attach() {
    toggle.addEventListener('click', () => {
      if (toggle.getAttribute('aria-expanded') === 'true') {
        closeMenu();
      } else {
        openMenu();
      }
    });

    panel.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
    overlay.addEventListener('click', closeMenu);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        closeMenu();
        toggle.focus();
      }
    });
  }
})();
</script>
