---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Services from '../../components/Services.astro';
import About from '../../components/About.astro';
import Features from '../../components/Features.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';

const navLinks = [
  { href: '#home', label: 'Home', active: true },
  { href: '#services', label: 'Services' },
  { href: '#about', label: 'About' },
  { href: '#features', label: 'Features' },
  { href: '#contact', label: 'Contact' },
];

const footerLinks = [
  { href: '#home', label: 'Home' },
  { href: '#services', label: 'Services' },
  { href: '#about', label: 'About' },
  { href: '#features', label: 'Features' },
  { href: '#contact', label: 'Contact' },
];
---

<Layout
  title="Sabq Center for Studies and Consulting Services"
  description="Sabq Center for Studies and Consulting Services — Specialized studies, strategic consulting, and practical solutions for organizations and individuals toward consulting excellence."
  lang="en"
  dir="ltr"
>
  <Header lang="en" links={navLinks} langHref="/" />

  <main id="main">
    <Hero
      badge="Towards Consulting Excellence That Makes a Difference"
      title="Sabq Center for Studies and <span class='accent'>Consulting Services</span>"
      description="We provide specialized studies, strategic consulting, and practical solutions for organizations and individuals, backed by scientific methodology and professional expertise to achieve your goals efficiently and effectively."
      primaryBtnText="Our Services"
      primaryBtnHref="#services"
      secondaryBtnText="Contact Us"
      secondaryBtnHref="#contact"
    />

    <Services
      title="Our Services"
      subtitle="A comprehensive suite of consulting and research services designed to meet your needs"
      items={[
        { icon: '📊', title: 'Studies & Reports', desc: 'Preparing feasibility studies and specialized analytical reports that support your strategic decisions with data and evidence.' },
        { icon: '🎯', title: 'Strategic Consulting', desc: 'Professional consulting in strategic planning, project management, and business development.' },
        { icon: '🎓', title: 'Training & Development', desc: 'Specialized training programs to develop human capital and build sustainable institutional capabilities.' },
        { icon: '📈', title: 'Data Analysis', desc: 'Data analysis and statistical indicators to monitor performance and make evidence-based decisions.' },
        { icon: '📋', title: 'Evaluation & Review', desc: 'Institutional performance evaluation and process review to ensure compliance with global best practices.' },
        { icon: '🌍', title: 'Market Research', desc: 'Market research, competitor analysis, and investment opportunity assessment in local and regional markets.' },
      ]}
    />

    <About
      title="About Us"
      paragraphs={[
        'Sabq Center for Studies and Consulting Services is a specialized center providing innovative consulting and research solutions for organizations and individuals. We strive for excellence in delivering consulting services through scientific methodology and a professional team with extensive experience in diverse fields.',
        'We believe that success begins with an informed decision, and therefore we are committed to providing accurate studies and practical consultations that help our clients achieve their goals efficiently and effectively.',
      ]}
      listItems={[
        'A team of certified consultants and experts',
        'Scientific methodology supported by data and evidence',
        'Customized solutions tailored to each client’s needs',
        'Commitment to confidentiality and professionalism',
      ]}
      stats={[
        { number: '50+', label: 'Studies Completed' },
        { number: '30+', label: 'Clients & Organizations' },
        { number: '10+', label: 'Years of Experience' },
        { number: '100%', label: 'Client Satisfaction' },
      ]}
    />

    <Features
      title="Our Features"
      subtitle="Why do clients choose us? Because we deliver real value and tangible results"
      items={[
        { icon: '⭐', title: 'Professional Expertise', desc: 'A team of experts with over ten years of experience in the consulting field.' },
        { icon: '🔬', title: 'Scientific Approach', desc: 'We rely on proven scientific methodologies in all our studies and consultations.' },
        { icon: '🤝', title: 'Sustainable Partnership', desc: 'We build long-term partnerships with our clients toward mutual success.' },
        { icon: '⚡', title: 'Fast Solutions', desc: 'We deliver practical solutions on time without compromising output quality.' },
      ]}
    />

    <Contact
      title="Contact Us"
      description="We are here to answer your inquiries and help you achieve your goals. Get in touch with us today."
      items={[
        { icon: '📧', text: 'info@sbq-center.com' },
        { icon: '📞', text: '+966 50 000 0000' },
        { icon: '📍', text: 'Riyadh, Saudi Arabia' },
        { icon: '🕐', text: 'Sun - Thu: 9 AM - 5 PM' },
      ]}
      formTitle="Contact Form"
      nameLabel="Full Name"
      emailLabel="Email Address"
      messageLabel="Your Message"
      namePlaceholder="Enter your full name"
      emailPlaceholder="example@email.com"
      messagePlaceholder="Write your message here..."
      submitText="Send Message"
    />
  </main>

  <Footer
    lang="en"
    links={footerLinks}
    centerName="Sabq Center for Studies and Consulting Services"
    centerTagline="Towards Consulting Excellence That Makes a Difference"
    copyright="© 2026 Sabq Center for Studies and Consulting Services. All rights reserved."
  />
</Layout>
