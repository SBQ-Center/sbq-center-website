---
import '../../styles/global.css';
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="SBQ Center for Studies and Consulting Services" />
    <title>SBQ Center for Studies and Consulting Services</title>
  </head>
  <body class="en">
    <div class="top">
      <div class="container">
        <span>From deep knowledge to sound decisions</span>
        <span>Independent research and consulting center</span>
      </div>
    </div>

    <header class="header">
      <div class="container nav">
        <a class="brand" href="/en/" aria-label="Home">
          <span class="mark">SBQ</span>
          <span>SBQ Center</span>
        </a>

        <div class="nav-group">
          <button
            class="nav-toggle"
            type="button"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="site-nav"
          >
            ☰
          </button>

          <nav id="site-nav" class="links" aria-label="Main navigation">
            <a href="#about">About</a>
            <a href="#publications">Publications</a>
            <a href="#programs">Programs</a>
            <a href="#services">Services</a>
            <a href="#experts">Experts</a>
            <a href="#contact">Contact</a>
          </nav>
        </div>

        <a class="lang" href="/">العربية</a>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="container hero-grid">
          <div class="hero-copy">
            <div class="eyebrow">SBQ Center for Studies and Consulting Services</div>
            <h1>From Deep Knowledge<br />to Sound Decisions</h1>
            <p>
              An independent research and consulting platform producing knowledge, analyzing policy,
              and delivering practical solutions that help institutions and decision-makers navigate change.
            </p>
            <div class="actions">
              <a class="btn" href="#publications">Explore Publications</a>
              <a class="btn secondary" href="#services">Request a Service</a>
            </div>
          </div>

          <div class="lens" aria-label="Knowledge lens symbol"></div>
        </div>
      </section>

      <section id="about" class="section">
        <div class="container">
          <div class="heading">
            <div>
              <h2>About the Center</h2>
              <p>Rigorous knowledge, in-depth analysis, and evidence-based consulting.</p>
            </div>
          </div>
        </div>
      </section>
    </main>

    <script>
      const header = document.querySelector('.header .nav');
      const toggle = document.querySelector('.nav-toggle');

      if (header && toggle) {
        toggle.addEventListener('click', () => {
          const isOpen = header.classList.toggle('open');
          toggle.setAttribute('aria-expanded', String(isOpen));
        });

        toggle.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            toggle.click();
          }
        });
      }
    </script>
  </body>
</html>
