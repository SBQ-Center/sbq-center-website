---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import About from '../components/About.astro';
import Features from '../components/Features.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

const navLinks = [
  { href: '#home', label: 'الرئيسية', active: true },
  { href: '#services', label: 'خدماتنا' },
  { href: '#about', label: 'من نحن' },
  { href: '#features', label: 'مميزاتنا' },
  { href: '#contact', label: 'تواصل معنا' },
];

const footerLinks = [
  { href: '#home', label: 'الرئيسية' },
  { href: '#services', label: 'خدماتنا' },
  { href: '#about', label: 'من نحن' },
  { href: '#features', label: 'مميزاتنا' },
  { href: '#contact', label: 'تواصل معنا' },
];
---

<Layout
  title="مركز سبق للدراسات والخدمات الاستشارية"
  description="مركز سبق للدراسات والخدمات الاستشارية — نقدم دراسات متخصصة واستشارات استراتيجية وحلولًا عملية لخدمة المؤسسات والأفراد نحو تميز استشاري يصنع الفرق."
  lang="ar"
  dir="rtl"
>
  <Header lang="ar" links={navLinks} langHref="/en/" />

  <main id="main">
    <Hero
      badge="نحو تميز استشاري يصنع الفرق"
      title="مركز سبق للدراسات والخدمات <span class='accent'>الاستشارية</span>"
      description="نقدم دراسات متخصصة واستشارات استراتيجية وحلولًا عملية لخدمة المؤسسات والأفراد، بمنهجية علمية وخبرة احترافية تحقق أهدافكم بكفاءة وفعالية."
      primaryBtnText="خدماتنا"
      primaryBtnHref="#services"
      secondaryBtnText="تواصل معنا"
      secondaryBtnHref="#contact"
    />

    <Services
      title="خدماتنا"
      subtitle="باقة متكاملة من الخدمات الاستشارية والدراسية المصممة لتلبية احتياجاتكم"
      items={[
        { icon: '📊', title: 'دراسات وتقارير', desc: 'إعداد دراسات جدوى وتقارير تحليلية متخصصة تدعم قراراتكم الاستراتيجية بالبيانات والأدلة.' },
        { icon: '🎯', title: 'استشارات استراتيجية', desc: 'تقديم استشارات احترافية في التخطيط الاستراتيجي وإدارة المشاريع وتطوير الأعمال.' },
        { icon: '🎓', title: 'تدريب وتطوير', desc: 'برامج تدريبية متخصصة لتطوير الكوادر البشرية وبناء القدرات المؤسسية المستدامة.' },
        { icon: '📈', title: 'تحليل بيانات', desc: 'تحليل البيانات وإعداد المؤشرات الإحصائية لرصد الأداء واتخاذ قرارات مبنية على الدليل.' },
        { icon: '📋', title: 'تقييم ومراجعة', desc: 'تقييم الأداء المؤسسي ومراجعة العمليات لضمان التمتثل لأفضل الممارسات العالمية.' },
        { icon: '🌍', title: 'دراسات سوق', desc: 'أبحاث السوق ودراسة المنافسين وتحليل الفرص الاستثمارية في الأسواق المحلية والإقليمية.' },
      ]}
    />

    <About
      title="من نحن"
      paragraphs={[
        'مركز سبق للدراسات والخدمات الاستشارية هو مركز متخصص يقدم حلولًا استشارية ودراسية مبتكرة للمؤسسات والأفراد. نسعى لتحقيق التميز في تقديم الخدمات الاستشارية من خلال منهجية علمية وفريق عمل احترافي ذي خبرة واسعة في مجالات متنوعة.',
        'نؤمن بأن النجاح يبدأ بقرار مدروس، ولذلك نحرص على تقديم دراسات دقيقة واستشارات عملية تساعد عملاءنا على تحقيق أهدافهم بكفاءة وفعالية.',
      ]}
      listItems={[
        'فريق من المستشارين والخبراء المعتمدين',
        'منهجية علمية مدعومة بالبيانات والأدلة',
        'حلول مخصصة تناسب احتياجات كل عميل',
        'التزام بالسرية والمهنية في كل تعاملاتنا',
      ]}
      stats={[
        { number: '+50', label: 'دراسة منجزة' },
        { number: '+30', label: 'عميل ومؤسسة' },
        { number: '+10', label: 'سنوات خبرة' },
        { number: '%100', label: 'رضا العملاء' },
      ]}
    />

    <Features
      title="مميزاتنا"
      subtitle="لماذا يختارنا العملاء؟ لأننا نقدم قيمة حقيقية ونتائج ملموسة"
      items={[
        { icon: '⭐', title: 'خبرة احترافية', desc: 'فريق من الخبراء بخبرة تزيد عن عشر سنوات في المجال الاستشاري.' },
        { icon: '🔬', title: 'منهجية علمية', desc: 'نعتمد على منهجيات علمية مثبتة في جميع دراساتنا واستشاراتنا.' },
        { icon: '🤝', title: 'شراكة مستدامة', desc: 'نبني علاقات شراكة طويلة الأمد مع عملائنا نحو نجاح مشترك.' },
        { icon: '⚡', title: 'حلول سريعة', desc: 'نقدم حلولًا عملية في الوقت المحدد دون المساس بجودة المخرجات.' },
      ]}
    />

    <Contact
      title="تواصل معنا"
      description="نحن هنا للإجابة على استفساراتكم ومساعدتكم في تحقيق أهدافكم. تواصلوا معنا اليوم."
      items={[
        { icon: '📧', text: 'info@sbq-center.com' },
        { icon: '📞', text: '+966 50 000 0000' },
        { icon: '📍', text: 'الرياض، المملكة العربية السعودية' },
        { icon: '🕐', text: 'الأحد - الخميس: 9 ص - 5 م' },
      ]}
      formTitle="نموذج التواصل"
      nameLabel="الاسم الكامل"
      emailLabel="البريد الإلكتروني"
      messageLabel="رسالتك"
      namePlaceholder="أدخل اسمك الكامل"
      emailPlaceholder="example@email.com"
      messagePlaceholder="اكتب رسالتك هنا..."
      submitText="إرسال الرسالة"
    />
  </main>

  <Footer
    lang="ar"
    links={footerLinks}
    centerName="مركز سبق للدراسات والخدمات الاستشارية"
    centerTagline="نحو تميز استشاري يصنع الفرق"
    copyright="© 2026 مركز سبق للدراسات والخدمات الاستشارية. جميع الحقوق محفوظة."
  />
</Layout>
